{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>doctolib/renovate-config"
  ],
  "constraints": {
    "erlang": ">=29"
  },
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "addLabels": ["auto-merge"]
    }
  ]
}
